<idea-plugin>
    <id>com.bocman.claudecommit</id>
    <name>Claude Commit</name>
    <vendor email="behemothad@gmail.com" url="https://github.com/behemoth-13">Bocman</vendor>
    <version>1.0.1</version>
    <idea-version since-build="232"/>
    <category>Version Control</category>
    <description><![CDATA[
        Adds a <b>Generate with Claude</b> button to the Git commit dialog.<br/>
        On click, it sends your staged diff and branch name to the locally installed
        <a href="https://claude.ai/download">Claude Code</a> CLI and fills in the
        commit message with the AI-generated result.<br/><br/>
        Configure the prompt template under <b>Settings → Tools → Claude Commit</b>.
    ]]></description>

    <change-notes><![CDATA[
        Initial release:
        <ul>
        <li>Generate commit messages using Claude Code</li>
        </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.bocman.claudecommit.ClaudeCommitSettings"/>
        <applicationConfigurable
                parentId="tools"
                instance="com.bocman.claudecommit.ClaudeCommitConfigurable"
                id="com.bocman.claudecommit.settings"
                displayName="Claude Commit"/>
        <checkinHandlerFactory implementation="com.bocman.claudecommit.ClaudeCommitHandlerFactory"/>
    </extensions>

    <actions>
        <action id="ClaudeCommit.Generate"
                class="com.bocman.claudecommit.GenerateWithClaudeAction"
                text="Generate with Claude"
                description="Generate a commit message using the local Claude Code CLI"
                icon="/icons/claudeCommit.svg">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
